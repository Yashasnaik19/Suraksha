# Suraksha Runtime Environment Configuration
# Leave external credentials unset to run in DEMO MODE (local mocks + real local security/rules).
# Never commit real API keys, AWS secrets, or signing keys.

APP_URL=
PORT=3000

# External Audio & Voice Layer (ElevenLabs Scribe v2 & TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SCRIBE_MODEL=scribe_v2_realtime
ELEVENLABS_DRILL_AGENT_ID=

# AWS Core Configuration (supports static keys or IAM role / temporary session credentials)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock (Contextual explanation & Hindi script — non-blocking)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_TIMEOUT_MS=2500

# Approval Service & Policy Enforcement
APPROVAL_TOKEN_TTL_SECONDS=120
# Note: Token HMAC signing key is read from APPROVAL_SIGNING_SECRET in production
# or generated ephemerally in memory during local dev.

# AWS Cognito, AgentCore Gateway & Lambda Interceptor
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AGENTCORE_GATEWAY_URL=
LAMBDA_INTERCEPTOR_ARN=
ORCHESTRATOR_LAMBDA_ARN=

# Notification & Tamper-Evident Audit Storage
SNS_TOPIC_ARN=
DYNAMODB_TABLE_NAME=
S3_AUDIT_BUCKET=

# Optional independent per-service mode overrides (MOCK | LIVE)
SURAKSHA_MODE_SCRIBE=
SURAKSHA_MODE_TTS=
SURAKSHA_MODE_BEDROCK=
SURAKSHA_MODE_GATEWAY=
SURAKSHA_MODE_SNS=
SURAKSHA_MODE_DYNAMODB=
SURAKSHA_MODE_S3=
SURAKSHA_MODE_THREAT_INTEL=
